# TMDB "API Read Access Token" (v4 bearer) from https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
# Alternative: the v3 API key. Used only when the read access token is empty.
TMDB_API_KEY=
# YouTube Data API v3 key for /api/trailer (background trailer search) and /api/channel-uploads (Catch-Up TV). Restrict it to the YouTube Data API.
YOUTUBE_API_KEY=
# Optional. When set, requests must send this value in the X-Saandio-Client header.
SAANDIO_CLIENT_TOKEN=
